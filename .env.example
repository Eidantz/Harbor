# Copy to repo root as `.env`, then:
#   ln -sf ../../.env apps/api/.env
# (Prisma CLI loads env from apps/api/)

# MCP client env (host). Token comes from Harbor → MCP tokens.
KANBAN_API_URL=http://localhost:3001
# KANBAN_API_TOKEN=

# Postgres (Compose service hostname is `db` inside the Docker network)
POSTGRES_USER=kanban
POSTGRES_PASSWORD=kanban
POSTGRES_DB=kanban
DATABASE_URL=postgresql://kanban:kanban@localhost:5432/kanban?schema=public

# Host-published ports (bound to 127.0.0.1)
API_PORT=3001
WEB_PORT=3000
POSTGRES_PORT=5432

# Nest API
NODE_ENV=development
# Cookie session secret for UI login (generate a long random string)
SESSION_SECRET=dev-session-secret-change-me

# CORS / public URLs for local dev outside Compose
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001
