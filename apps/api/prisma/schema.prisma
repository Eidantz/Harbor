generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IssueType {
  task
  bug
  story
}

enum IssuePriority {
  lowest
  low
  medium
  high
  highest
}

enum IssueLinkType {
  blocks
  relates_to
  duplicates
}

enum ActivityType {
  created
  updated
  moved
  linked
  commented
}

enum BoardLayout {
  columns
  list
}

enum CustomColumnType {
  text
  number
  date
  label
  person
  file
  checkbox
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedIssues Issue[]         @relation("IssueAssignee")
  comments       Comment[]
  activityEvents ActivityEvent[]
  apiTokens      ApiToken[]
}

/// Long-lived Bearer tokens for MCP / API clients (plaintext shown once at creation).
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  name       String
  /// sha256 hex of the raw token
  tokenHash  String    @unique
  /// Visible prefix for identification (e.g. hbr_xxxx)
  prefix     String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([revokedAt])
}

model Project {
  id           String      @id @default(cuid())
  name         String
  key          String      @unique
  description  String?
  theme        String      @default("tokyo-night")
  boardLayout  BoardLayout @default(columns)
  /// Visible Monday-list table field ids (JSON string array)
  listFields   Json        @default("[\"key\",\"title\",\"assignee\",\"epic\",\"status\",\"document\",\"description\",\"priority\",\"humanEffort\",\"locEffort\",\"dueDate\",\"type\",\"labels\",\"blockers\"]")
  /// Per-column pixel widths for the list table (JSON map of field/column id -> px)
  listWidths   Json        @default("{}")
  issueCounter Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  columns        BoardColumn[]
  issues         Issue[]
  labels         Label[]
  epics          Epic[]
  activityEvents ActivityEvent[]
  customColumns  CustomColumn[]

  @@index([name])
}

model Epic {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  /// Short summary (max 300 chars at the API level)
  description String?
  /// Long-form markdown plan/spec document
  document    String?
  color       String   @default("#7aa2f7")
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]

  @@index([projectId])
  @@index([projectId, position])
}

model BoardColumn {
  id        String   @id @default(cuid())
  projectId String
  name      String
  position  Int
  isDone    Boolean  @default(false)
  /// Optional hex accent for column outline (e.g. #7aa2f7)
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]

  @@unique([projectId, name])
  @@unique([projectId, position])
  @@index([projectId])
}

model Issue {
  id          String        @id @default(cuid())
  projectId   String
  columnId    String
  parentId    String?
  epicId      String?
  assigneeId  String?
  key         String
  number      Int
  title       String
  /// Short summary (max 300 chars at the API level)
  description String?
  /// Long-form markdown plan/spec document
  document    String?
  type        IssueType     @default(task)
  priority    IssuePriority @default(medium)
  /// Estimated human effort in hours
  humanEffort Float?
  /// Estimated lines-of-code effort
  locEffort   Int?
  /// Target completion date
  dueDate     DateTime?
  /// Set when the issue is archived (hidden from the board, restorable)
  archivedAt  DateTime?
  /// Lexicographic rank for ordering within a column
  rank        String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column    BoardColumn  @relation(fields: [columnId], references: [id], onDelete: Restrict)
  epic      Epic?        @relation(fields: [epicId], references: [id], onDelete: SetNull)
  parent    Issue?       @relation("IssueSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks  Issue[]      @relation("IssueSubtasks")
  assignee  User?        @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  labels       IssueLabel[]
  comments     Comment[]
  activity     ActivityEvent[]
  attachments  Attachment[]
  customValues IssueCustomValue[]

  linksFrom IssueLink[] @relation("LinkSource")
  linksTo   IssueLink[] @relation("LinkTarget")

  @@unique([projectId, key])
  @@unique([projectId, number])
  @@index([projectId])
  @@index([columnId])
  @@index([parentId])
  @@index([epicId])
  @@index([assigneeId])
  @@index([projectId, columnId, rank])
  @@index([projectId, archivedAt])
}

/// User-defined list-table column (Monday-style custom field).
model CustomColumn {
  id        String           @id @default(cuid())
  projectId String
  name      String
  type      CustomColumnType
  position  Int
  /// Type-specific config, e.g. label options [{ id, name, color }]
  settings  Json             @default("{}")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  project Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  values  IssueCustomValue[]

  @@index([projectId])
  @@index([projectId, position])
}

/// Per-issue value for a custom column. Value shape depends on column type:
/// { text } | { number } | { date } | { optionId } | { userId } | { attachmentId, filename } | { checked }
model IssueCustomValue {
  issueId  String
  columnId String
  value    Json

  issue  Issue        @relation(fields: [issueId], references: [id], onDelete: Cascade)
  column CustomColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@id([issueId, columnId])
  @@index([columnId])
}

model IssueLink {
  id        String        @id @default(cuid())
  sourceId  String
  targetId  String
  type      IssueLinkType @default(blocks)
  createdAt DateTime      @default(now())

  source Issue @relation("LinkSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target Issue @relation("LinkTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, type])
  @@index([sourceId])
  @@index([targetId])
}

model Label {
  id        String   @id @default(cuid())
  projectId String
  name      String
  color     String   @default("#6B7280")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  IssueLabel[]

  @@unique([projectId, name])
  @@index([projectId])
}

model IssueLabel {
  issueId String
  labelId String

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([issueId, labelId])
  @@index([labelId])
}

model Attachment {
  id         String   @id @default(cuid())
  issueId    String
  /// Original filename as uploaded
  filename   String
  mimeType   String
  /// File size in bytes
  size       Int
  /// Randomized name of the file on disk (UPLOAD_DIR)
  storedName String   @unique
  createdAt  DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
}

model Comment {
  id        String   @id @default(cuid())
  issueId   String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issue  Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@index([authorId])
}

model ActivityEvent {
  id        String       @id @default(cuid())
  projectId String
  issueId   String?
  actorId   String?
  type      ActivityType
  payload   Json         @default("{}")
  createdAt DateTime     @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issue   Issue?  @relation(fields: [issueId], references: [id], onDelete: SetNull)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([issueId, createdAt])
  @@index([actorId])
}
