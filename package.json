{
  "name": "kanban-board",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "workspaces": ["apps/*"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "bun run --filter @kanban/api --filter @kanban/web --parallel dev",
    "dev:api": "bun run --filter @kanban/api dev",
    "dev:web": "bun run --filter @kanban/web dev",
    "dev:mcp": "bun run --filter @kanban/mcp dev",
    "build": "bun run --workspaces --if-present build",
    "build:api": "bun run --filter @kanban/api build",
    "build:web": "bun run --filter @kanban/web build",
    "build:mcp": "bun run --filter @kanban/mcp build",
    "start:api": "bun run --filter @kanban/api start:prod",
    "db:generate": "bun run --filter @kanban/api prisma:generate",
    "db:migrate": "bun run --filter @kanban/api prisma:migrate",
    "db:migrate:deploy": "bun run --filter @kanban/api prisma:migrate:deploy",
    "db:seed": "bun run --filter @kanban/api prisma:seed",
    "db:studio": "bun run --filter @kanban/api prisma:studio",
    "lint": "bun run --workspaces --if-present lint",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "setup:env": "cp -n .env.example .env 2>/dev/null || true; ln -sfn ../../.env apps/api/.env",
    "smoke": "bun run scripts/smoke.mjs"
  }
}
