{
  "mcpServers": {
    "harbor-kanban-board": {
      "type": "stdio",
      "command": "node",
      "args": ["/absolute/path/to/Harbor/apps/mcp/dist/index.js"],
      "env": {
        "KANBAN_API_URL": "http://127.0.0.1:3001",
        "KANBAN_API_TOKEN": "<paste token from Harbor → MCP tokens>"
      }
    }
  }
}
